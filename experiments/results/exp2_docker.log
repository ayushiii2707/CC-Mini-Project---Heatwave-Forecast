### 3. Failure scenarios (through the frontend proxy)
# unknown city
{"detail":"unknown city 'Atlantis'. Supported: Delhi, Jaipur, Lucknow, Patna, Ahmedabad, Nagpur, Kolkata, Bhubaneswar, Hyderabad, Chennai"} HTTP 404
# 99.9 = IMD missing code
{"detail":[{"type":"value_error","loc":["body","recent_tmax"],"msg":"Value error, temperature 99.9 C is outside the plausible range -10..55 C","input":[40,41,42,43,44,45,99.9],"ctx":{"error":{}}}]} HTTP 422
# date outside the data
{"detail":"no IMD observations for Delhi for the 7 days up to 2030-05-01 (available: 2014-01-07 to 2024-12-31)"} HTTP 404
# backend stopped -> frontend stays up, API calls fail with a gateway error
  /healthz HTTP 200   /api/health HTTP 504
# backend restarted -> /api/health HTTP 200

### 4. Push both images to Docker Hub for linux/arm64 and linux/amd64
$ docker buildx build --platform linux/arm64,linux/amd64 -t ayushiranjan27/heatguard:2.0 -t ayushiranjan27/heatguard:latest --push --quiet .
sha256:8eebf471058fa7828a1791c7998ca8463b46e992178fd7f2ff64b8300d2da039

$ docker buildx build --platform linux/arm64,linux/amd64 -t ayushiranjan27/heatguard-web:2.0 -t ayushiranjan27/heatguard-web:latest --push --quiet ./frontend
sha256:9506d974586291f17a469f16ffbbc2a21c4fa9470158b961b819bd7a850167a7

$ docker buildx imagetools inspect ayushiranjan27/heatguard:2.0 | grep Platform
  Platform:    linux/arm64
  Platform:    linux/amd64

$ docker buildx imagetools inspect ayushiranjan27/heatguard-web:2.0 | grep Platform
  Platform:    linux/arm64
  Platform:    linux/amd64

