# Failure scenario 1: unknown city
$ curl -s -w " HTTP %{http_code}" -X POST localhost:8000/predict -d {"city":"Atlantis",...}
{"detail":"unknown city 'Atlantis'. Supported: Delhi, Jaipur, Lucknow, Patna, Ahmedabad, Nagpur, Kolkata, Bhubaneswar, Hyderabad, Chennai"} HTTP 404

# Failure scenario 2: implausible sensor value (99.9 = IMD missing code)
{"detail":[{"type":"value_error","loc":["body","recent_tmax"],"msg":"Value error, temperature 99.9 C is outside the plausible range -10..55 C","input":[40,41,42,43,44,45,99.9],"ctx":{"error":{}}}]} HTTP 422

# Failure scenario 3: only 3 values instead of 7
{"detail":[{"type":"too_short","loc":["body","recent_tmax"],"msg":"List should have at least 7 items after validation, not 3","input":[40,41,42],"ctx":{"field_type":"List","min_length":7,"actual_length":3}}]} HTTP 422

